{
  "productName": "Splorer",
  "version": "../../package.json",
  "identifier": "org.snakeos.splorer",
  "build": {
    "beforeBuildCommand": "pnpm -w frontend:build",
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [
      {
        "title": "Splorer - File Explorer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 12, "y": 20 },
        "alwaysOnTop": false,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
        "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://asset.localhost http://asset.localhost http://localhost:*; media-src 'self' asset: https://asset.localhost http://asset.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$LOCALAPPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**", "$PICTURE/**", "$VIDEO/**", "$AUDIO/**", "../client/dist/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../packages/cli/bin/splorer.mjs": "splorer.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Splorer",
    "copyright": "Copyright 2025 Splorer",
    "category": "Utility",
    "shortDescription": "Modern file explorer",
    "longDescription": "A modern file explorer built with Tauri, React, and TypeScript",
    "fileAssociations": [
      {
        "ext": ["xtension"],
        "mimeType": "application/x-xplorer-extension",
        "description": "Splorer Extension Package"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
