+static mut OLE_RESULT: Result<()> = Ok(());
+static OLE_UNINITIALIZE: Once = Once::new();
+fn init_ole() {
+    OLE_UNINITIALIZE.call_once(|| {
+        unsafe {
+            OLE_RESULT = OleInitialize(Some(std::ptr::null_mut()));
+        }
+        // I guess we never deinitialize for now?
+        // OleUninitialize
+    });
+}
