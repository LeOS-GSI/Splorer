Ohne select-none startete WebKitGTK beim Ziehen eine Textmarkierung
und schnappte die Maus weg, sodass startDrag nie griff.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GWWpEUX1W65k9BrLDCn2Ma
---
 apps/client/src/components/explorer/DetailsView.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/client/src/components/explorer/DetailsView.tsx b/apps/client/src/components/explorer/DetailsView.tsx
index 5a27537..42e7b41 100644
--- a/apps/client/src/components/explorer/DetailsView.tsx
+++ b/apps/client/src/components/explorer/DetailsView.tsx
@@ -164,7 +164,7 @@ const FileRow = React.memo(
         tabIndex={0}
         data-file-path={file.path}
         data-drop-target={file.is_dir ? file.path : undefined}
-        className={`hover:bg-xp-surface-light grid cursor-pointer grid-cols-12 items-center gap-3 px-3 py-2.5 transition-colors ${
+        className={`hover:bg-xp-surface-light grid cursor-pointer select-none grid-cols-12 items-center gap-3 px-3 py-2.5 transition-colors ${
           selectedFiles.has(file.path)
             ? 'bg-xp-purple/20 border-xp-purple/40 border'
             : 'text-xp-text border border-transparent'
